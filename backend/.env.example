MODEL_PATH=app/ml/dummy_retina_model.keras
MODEL_TYPE=DEMO
MODEL_VERSION=dummy-v1
SEED_DEMO=true
FRONTEND_ORIGINS=http://localhost:3000
# Empty means deletion is disabled. Configure a strong, private administrator key to enable it.
API_ADMIN_KEY=
# Optional; defaults to backend/data/retinaai.db using an absolute path.
# DATABASE_URL=sqlite:////absolute/persistent/path/retinaai.db
UPLOAD_DIR=uploads
# The fixed input contract is RGB float32 0-255, centrally cropped/resized to 224x224.
# Normalization must be embedded inside the exported Keras model.
